# Frontend Development Environment (.env.local)

# By default in development (npm run dev), Next.js proxies API calls to http://localhost:5000
# To customize the local backend URL:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_URL=http://localhost:5000

# If you ever want your local frontend to point to the live Hostinger production backend instead:
# NEXT_PUBLIC_API_URL=https://firebrick-gnat-591688.hostingersite.com/api
# BACKEND_URL=https://firebrick-gnat-591688.hostingersite.com
